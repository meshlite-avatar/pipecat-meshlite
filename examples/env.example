# Copy to examples/.env and fill in. Never commit .env.

# Azure AI Services resource (Speech + Azure OpenAI): key, region, endpoint, chat deployment.
AZURE_API_KEY=
AZURE_REGION=swedencentral
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_MODEL=gpt-5.4-mini

# MeshLite Console (Projects, For developers): keys of the same environment, avatar id.
MESHLITE_PUBLISHABLE_KEY=ml_pk_test_...
MESHLITE_SECRET_KEY=ml_sk_test_...
MESHLITE_AVATAR=
# Address of the page; declare it in the console under Allowed sites.
MESHLITE_ORIGIN=http://localhost:7860
